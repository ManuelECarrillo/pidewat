# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en el servidor. Nunca se pone en el navegador ni en el código.
SUPABASE_SERVICE_ROLE_KEY=

# Dirección pública de la app (sin diagonal al final)
NEXT_PUBLIC_SITE_URL=https://pidewat.mx

# WhatsApp de Pidewat para ventas y soporte (con lada de país)
NEXT_PUBLIC_PIDEWAT_WHATSAPP=521XXXXXXXXXX

# Meta: el píxel solo carga después de aceptar cookies; el token nunca llega al navegador.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
# Opcional: solo para revisar eventos en el administrador de eventos de Meta.
META_TEST_EVENT_CODE=

# Mercado Pago > Tus integraciones > Credenciales de producción
MP_ACCESS_TOKEN=
# Mercado Pago > Webhooks > clave secreta (opcional, recomendado)
MP_WEBHOOK_SECRET=
