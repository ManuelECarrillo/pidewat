# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en el servidor. Nunca se pone en el navegador ni en el código.
SUPABASE_SERVICE_ROLE_KEY=

# Dirección pública de la app (sin diagonal al final)
NEXT_PUBLIC_SITE_URL=https://pidewa.mx

# WhatsApp de Pidewa para ventas y soporte (con lada de país)
NEXT_PUBLIC_PIDEWA_WHATSAPP=521XXXXXXXXXX

# Mercado Pago > Tus integraciones > Credenciales de producción
MP_ACCESS_TOKEN=
# Mercado Pago > Webhooks > clave secreta (opcional, recomendado)
MP_WEBHOOK_SECRET=
